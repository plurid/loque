{
    "name": "@plurid/loque",
    "version": "0.0.0-0",
    "description": "Query and mutation engine for JSON, combining deterministic predicates with typed probabilistic judgments",
    "keywords": [
        "json",
        "query",
        "mutation",
        "json-patch",
        "json-pointer",
        "lens",
        "probabilistic",
        "judgment",
        "llm",
        "agents",
        "loque"
    ],
    "author": "ly3xqhl8g9 <ly3xqhl8g9@plurid.com> (https://plurid.com)",
    "license": "SEE LICENSE IN LICENSE",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/plurid/loque.git",
        "directory": "packages/loque-javascript"
    },
    "bugs": {
        "email": "source@plurid.com",
        "url": "https://github.com/plurid/loque/issues"
    },
    "homepage": "https://github.com/plurid/loque/blob/master/packages/loque-javascript/README.md",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@11.3.0",
    "type": "commonjs",
    "main": "./distribution/index.cjs",
    "module": "./distribution/index.mjs",
    "types": "./distribution/index.d.cts",
    "exports": {
        ".": {
            "import": {
                "types": "./distribution/index.d.mts",
                "default": "./distribution/index.mjs"
            },
            "require": {
                "types": "./distribution/index.d.cts",
                "default": "./distribution/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "sideEffects": false,
    "files": [
        "distribution"
    ],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
        "lint": "eslint . --max-warnings 0",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "check:docs": "node scripts/check-readme.mjs",
        "check:package": "node scripts/check-package.mjs",
        "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm check:docs && pnpm check:package",
        "prepack": "pnpm build",
        "prepublishOnly": "pnpm verify"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.20.4",
        "@vitest/coverage-v8": "5.0.1",
        "ajv": "^8.20.0",
        "eslint": "^10.11.0",
        "publint": "^0.3.24",
        "tsdown": "^0.23.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vitest": "5.0.1"
    }
}
